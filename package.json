{
  "name": "borg-js",
  "version": "0.1.0",
  "description": "Biblioteca JavaScript educacional com funções em português para reagir a cliques, mouse e teclado sem complicação com o DOM.",
  "type": "module",
  "main": "./dist/borg.mjs",
  "module": "./dist/borg.mjs",
  "exports": {
    ".": {
      "import": "./dist/borg.mjs",
      "default": "./dist/borg.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.js",
    "build": "vite build",
    "build:docs": "vite build --config vite.docs.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "dom",
    "educacional",
    "portugues",
    "eventos"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
