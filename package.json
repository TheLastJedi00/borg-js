{
  "name": "borg-js",
  "version": "0.1.0",
  "description": "Biblioteca JavaScript educacional com funções em português para reagir a cliques, mouse e teclado sem complicação com o DOM.",
  "type": "module",
  "main": "./dist/borg.mjs",
  "module": "./dist/borg.mjs",
  "exports": {
    ".": {
      "import": "./dist/borg.mjs",
      "default": "./dist/borg.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.js",
    "build": "vite build",
    "build:docs": "vite build --config vite.docs.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "dom",
    "educacional",
    "portugues",
    "eventos"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
